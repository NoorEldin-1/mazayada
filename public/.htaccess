# WebSocket proxy → Laravel Reverb (live auctions, spec §6): sends
# wss://<domain>/app/{key} to the internal Reverb instead of index.php.
#
# THIS BLOCK IS TRANSCRIBED FROM A CONFIGURATION VERIFIED ON THE LIVE SERVER
# (404 before, 101 after). Every detail below is load-bearing — three of them
# were each, on their own, enough to silently break the handshake and leave the
# auction page with no live updates at all:
#
#  • http://, not ws:// — LiteSpeed Enterprise 6.2 (this host runs it in
#    Apache-config mode, so its WebAdmin lists zero virtual hosts and the
#    Web Socket Proxy screen there cannot be used) 404s a ws:// proxy target,
#    and performs the upgrade itself when the target is http://.
#  • Port 8081, not Reverb's default 8080 — another tenant on this shared
#    server already listens on 8080 with its own app registry, which is what
#    answered "No matching application for ID [170884]". REVERB_PORT and
#    REVERB_SERVER_PORT in .env must stay 8081 to match.
#  • ONE condition, on Upgrade only. Adding the usual companion
#    `RewriteCond %{HTTP:Connection} upgrade` makes the rule stop matching —
#    LiteSpeed does not expose that hop-by-hop header to mod_rewrite.
#
# It lives at the top of the file, ahead of the front-controller block, because
# it has to win before Laravel's `RewriteRule ^ index.php` claims the URL.
# Keep it COMMITTED: deploys run `git reset --hard`, which erases any fix that
# only exists on the server.
<IfModule LiteSpeed>
RewriteEngine On
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule ^app/(.*)$ http://127.0.0.1:8081/app/$1 [P,L]
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
